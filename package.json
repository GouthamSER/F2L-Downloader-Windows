{
  "name": "f2l-downloader-desktop",
  "productName": "F2L Downloader",
  "version": "3.5.0",
  "description": "F2L Downloader for Windows \u2014 multi-threaded segmented downloads, magnet links, qBittorrent hand-off, batch import.",
  "main": "main.js",
  "author": "Goutham Josh",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.js && node test/qbit.test.js",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "build": {
    "appId": "com.f2l.downloader.desktop",
    "productName": "F2L Downloader",
    "files": [
      "main.js",
      "preload.js",
      "engine.js",
      "qbit.js",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "F2L-Downloader-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "F2L-Downloader-Portable-${version}.${ext}"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
